{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "node:*": ["../../../../vendor/node_modules/@types/node/*"],
      "react": ["../../../../vendor/node_modules/@types/react"],
      "react/jsx-runtime": ["../../../../vendor/node_modules/@types/react/jsx-runtime"],
      "react/jsx-dev-runtime": ["../../../../vendor/node_modules/@types/react/jsx-dev-runtime"],
      "react-dom": ["../../../../vendor/node_modules/@types/react-dom"],
      "react-dom/client": ["../../../../vendor/node_modules/@types/react-dom/client"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
